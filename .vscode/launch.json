     "configurations": [
     {
        "name": "LaunchGo",
        "type": "go",
        "request": "launch",
        "mode": "auto",
        "program": "${fileDirname}",
        //"args": ["run", "c:\\Users\\JensJ\\Projects\\Gauge\\test\\specs\\example.spec:13"]
        "args": ["format", "--skip-empty-line-insertions=false", "c:\\Users\\JensJ\\Projects\\gauge\\test\\specs\\test.spec"]
    }
    ,
    {
        "name": "Attach to Go Process",
        "type": "go",
        "request": "attach",
        // One of the following approaches:
        // 1) Provide a known process ID (if you already know the PID):
        // "processId": 12345,
        // 2) Ask VS Code to show a process picker dialog:
        "processId": "${command:pickProcess}",
